rules_version = '2';
// Firebase コンソールの「Firestore Database → ルール」にこの内容を貼り付けて「公開」する
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // 公開部屋だけを一覧に出す。招待リンクのIDを知る認証済みユーザーは個別取得できる
    match /hubs/{hubId} {
      allow get: if signedIn();
      allow list: if resource.data.visibility == 'public';
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'invite']
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'invite']
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // 参加したい人と主のあいだの接続の仲介
      match /joins/{joinId} {
        allow read: if signedIn() && (resource.data.uid == request.auth.uid || get(/databases/$(database)/documents/hubs/$(hubId)).data.hostUid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.offer is string && request.resource.data.offer.size() < 20000;
        allow update: if signedIn()
          && get(/databases/$(database)/documents/hubs/$(hubId)).data.hostUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // 投稿時は未クリア。公開済みのタイルは変更不可（修正は別IDで再投稿）。
    match /courses/{courseId} {
      allow read: if true;
      allow delete: if isAccount() && resource.data.author == request.auth.uid;
      allow create: if isAccount()
        && request.resource.data.keys().hasOnly(['id', 'author', 'authorName', 'createdAt', 'status', 'map'])
        && request.resource.data.id == courseId
        && courseId.matches('user-[a-f0-9]{18}')
        && request.resource.data.author == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.status == 'prerelease'
        && request.resource.data.createdAt is number
        && request.resource.data.map.id == courseId
        && request.resource.data.map.name is string && request.resource.data.map.name.size() > 0 && request.resource.data.map.name.size() <= 40
        && request.resource.data.map.description is string && request.resource.data.map.description.size() <= 280
        && request.resource.data.map.minPlayers in [1, 2, 3, 4, 5, 6, 7, 8]
        && request.resource.data.map.width is int && request.resource.data.map.width >= 20 && request.resource.data.map.width <= 900
        && request.resource.data.map.height is int && request.resource.data.map.height >= 16 && request.resource.data.map.height <= 897
        && request.resource.data.map.tiles is list && request.resource.data.map.tiles.size() == request.resource.data.map.height;
      // ブラウザ信頼モデル。ログイン中の最初のクリア者を一度だけ登録。
      allow update: if isAccount()
        && !('firstClear' in resource.data)
        && resource.data.status == 'prerelease' && request.resource.data.status == 'released'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'firstClear'])
        && request.resource.data.firstClear.keys().hasOnly(['uid', 'names', 'time', 'at'])
        && request.resource.data.firstClear.uid == request.auth.uid
        && request.resource.data.firstClear.names is list
        && request.resource.data.firstClear.names.size() == 1
        && request.resource.data.firstClear.names[0] == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.firstClear.time is number && request.resource.data.firstClear.time >= 0
        && request.resource.data.firstClear.at is number;
    }

    // アカウントの表示名
    match /users/{uid} {
      allow read: if true;
      allow create: if isAccount() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 16;
    }

    // ステージごとの自己ベスト（速くなるときだけ書き換えられる）
    match /stages/{stageId}/best/{uid} {
      allow read: if true;
      allow write: if isAccount() && request.auth.uid == uid
        && request.resource.data.time is number && request.resource.data.time >= 3
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name
        && (resource == null || request.resource.data.time < resource.data.time);
    }
  }
}
